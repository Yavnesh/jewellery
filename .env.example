# ==============================================================================
# JEWELLERY APPLICATION - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` for local development or set variables in your cloud provider.
# NEVER commit your actual `.env` file containing secrets to version control.

# Application Base Settings
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# NextAuth Authentication
# Generate a secure secret in production: openssl rand -base64 32
NEXTAUTH_SECRET=changeme_in_production_min_32_chars_random
NEXTAUTH_URL=http://localhost:3000

# Database Configuration (Prisma / MySQL)
# For local Docker Compose: mysql://root:root_password@db:3306/jewellery_db
# For host-to-Docker access: mysql://root:root_password@127.0.0.1:3306/jewellery_db
DATABASE_URL=mysql://root:root_password@db:3306/jewellery_db

# Redis Cache / Rate Limiting (Optional in local mock mode)
# For local Docker Compose: redis://redis:6379
REDIS_URL=redis://redis:6379

# Payment Gateway Configurations
PAYMENT_ROUTING_CURRENCY=INR
SKYDO_THRESHOLD_MINOR=100000
PAYMENT_RETURN_URL=http://localhost:3000/checkout/callback

# Razorpay (Test Credentials for Local Dev)
RAZORPAY_KEY_ID=rzp_test_dummy_key_id
RAZORPAY_KEY_SECRET=dummy_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=dummy_razorpay_webhook_secret

# Skydo International Payment Gateway (Optional)
SKYDO_API_KEY=dummy_skydo_key
SKYDO_API_SECRET=dummy_skydo_secret
SKYDO_WEBHOOK_SECRET=dummy_skydo_webhook_secret

# OAuth Authentication Providers (Optional for local dev)
AUTH_GOOGLE_ID=dummy-google-client-id
AUTH_GOOGLE_SECRET=dummy-google-secret
AUTH_APPLE_ID=dummy-apple-client-id
AUTH_APPLE_SECRET=dummy-apple-secret
AUTH_FACEBOOK_ID=dummy-facebook-client-id
AUTH_FACEBOOK_SECRET=dummy-facebook-secret

# Email & Notifications (Resend / Mailpit in Compose)
RESEND_API_KEY=re_dummy_resend_api_key

# Monitoring & Error Tracking (Optional)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
